{
  "manifest_version": 3,
  "name": "Contact Form Helper",
  "version": "1.1.0",
  "description": "User-controlled helper for filling contact forms and submitting with an explicit shortcut.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*", "http://127.0.0.1:8765/*"],
  "action": {
    "default_title": "Contact Form Helper",
    "default_popup": "popup.html"
  },
  "commands": {
    "fill-current-form": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Fill the current contact form"
    },
    "open-next-queue-record": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "Open the next eligible queue record"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
